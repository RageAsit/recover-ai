{
  "permissions": {
    "allow": [
      "Bash(node --check server.js)",
      "Bash(PORT=5058 node server.js)",
      "Bash(curl -s -w \" | HTTP %{http_code}\\\\n\" http://localhost:5058/api/health)",
      "Bash(curl -s -w \" | HTTP %{http_code}\\\\n\" http://localhost:5058/api/test/razorpay)",
      "Bash(powershell -NoProfile -Command 'Get-CimInstance Win32_Process -Filter \"Name='\\\\''node.exe'\\\\''\" | Where-Object { $_.CommandLine -like '\\\\''*server.js*'\\\\'' -and $_.CommandLine -notlike '\\\\''*nodemon*'\\\\'' } | ForEach-Object { Stop-Process -Id $_.ProcessId -Force }')",
      "Bash(npm run *)",
      "Read(//tmp/**)",
      "Bash(curl -s -o /dev/null -w \"index.html   HTTP %{http_code}\\\\n\" http://localhost:5173/)",
      "Bash(curl -s -o /dev/null -w \"main.jsx     HTTP %{http_code}\\\\n\" http://localhost:5173/src/main.jsx)",
      "Bash(curl -s http://localhost:5173/)",
      "Bash(xargs sha256sum)",
      "Bash(npx oxlint *)",
      "Bash(echo \"oxlint exit=$?\")"
    ]
  }
