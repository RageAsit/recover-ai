PORT=5000

# Allowed frontend origin(s) for CORS in production/decoupled deployment (comma-separated)
# In local development, localhost and 127.0.0.1 on any port are automatically allowed.
# Example for production: https://recover-ai-demo.vercel.app
FRONTEND_ORIGIN=

# Database Connection
# IMPORTANT FOR DEMO ISOLATION: When running in DEMO_MODE=true, point to an isolated demo database
# (e.g. mongodb://localhost:27017/recoverai_demo) so demo operations never touch production data.
MONGODB_URI=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Demo Mode & Mock Controls (Development / Buildathon Demo)
# Set DEMO_MODE=true to enable the interactive demo endpoints (/api/demo/*)
DEMO_MODE=false
# When DEMO_MODE=true and RAZORPAY_MOCK=true, payment links are generated synthetically
# without calling the external Razorpay API. Real DB state transitions still execute.
RAZORPAY_MOCK=false
# When LLM_MOCK=true, Gemini API calls return simulated recommendations without live LLM calls
LLM_MOCK=true

LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=

RECOVERY_MAX_ATTEMPTS=
RECOVERY_MAX_AMOUNT_PAISE=
TEST_CONTACT=